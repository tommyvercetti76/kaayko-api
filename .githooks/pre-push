#!/bin/sh
# Scans every commit actually being pushed, not just the last one — the leak this
# was written for was five commits deep and three days old.
set -eu
root=$(git rev-parse --show-toplevel)
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$(git rev-list --max-parents=0 "$local_sha" | tail -1)..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  "$root/.githooks/scan.sh" range "$range" || status=1
done
exit $status

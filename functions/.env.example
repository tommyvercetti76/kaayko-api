# Kaayko API — required environment variables (functions/.env)
# Copy to `.env` and fill real values. NEVER commit the real .env (gitignored).
# Values here are placeholders only.

# --- Admin / Kortex auth ---
ADMIN_PASSPHRASE=            # dedicated admin-key secret (X-Admin-Key). Do NOT reuse KORTEX_SYNC_KEY.
KORTEX_SYNC_KEY=            # secret for ROOTS/cool-schools sync + HMAC (keep separate from ADMIN_PASSPHRASE)
KORTEX_IP_SALT=            # high-entropy salt for click-event IP hashing (fail if unset in prod)
KORTEX_LINK_SIGNING_SECRET= # HMAC secret for signed link ?sig= verification
ALUMNI_TOKEN_SECRET=       # HMAC secret for alumni visit/report tokens
SESSION_SECRET=            # kreator session signing secret (required in prod; no dev fallback)

# --- Stripe (billing + store checkout) ---
# In PRODUCTION these two are NOT read from this file: they must live in Secret
# Manager and be listed in the `secrets:` array of `exports.api` in
# functions/index.js, otherwise the deployed function has no Stripe key and
# /api/createPaymentIntent 500s with "STRIPE_SECRET_KEY not configured".
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# Firebase-managed secret values arrive with a trailing newline — consumers .trim().
STRIPE_SECRET_KEY=         # sk_live_... (server only, never sent to client)
STRIPE_WEBHOOK_SECRET=     # whsec_... (signature verification)
STRIPE_PRICE_PRO=          # price_... for the Pro plan
STRIPE_PRICE_BUSINESS=     # price_... for the Business plan

# --- Store order notifications ---
# Where "new order" / "payment failed" / "webhook failure" alerts are sent.
# Optional: when unset the code default (rohanramekar17@gmail.com) is used, so
# the owner is never silently un-notified. Set it to change the address without
# a code edit — it also overrides the notifyEmail stamped on older payment
# intents. A malformed value is ignored and the fallback chain continues.
ORDER_NOTIFY_EMAIL=        # e.g. rohanramekar17@gmail.com
#
# DELIVERY WARNING: all of these emails are written to the Firestore `mail`
# collection and are only actually SENT if the `firestore-send-email` Firebase
# Extension is installed on the project:
#   firebase ext:install firebase/firestore-send-email --project=kaaykostore
# (collection: `mail`, SMTP URI: your SendGrid/Gmail credentials).
# Verify with: firebase ext:list --project kaaykostore

# --- Third-party services ---
ANTHROPIC_API_KEY=         # Claude (kutz)
WEATHER_API_KEY=           # weather provider (paddling)
ML_SERVICE_URL=            # internal ML service base URL
FITBIT_CLIENT_ID=          # Fitbit OAuth (kutz)
FITBIT_CLIENT_SECRET=      # Fitbit OAuth (kutz)

# ── Kortex destination safety (Phase 1 trust pass) ─────────────────────────
# Google Safe Browsing Lookup API v4 key. When unset the lookup is skipped and
# only the private-host, blocklist and domain-reputation checks run.
GOOGLE_SAFE_BROWSING_API_KEY=
# true → a failed Safe Browsing lookup holds the link for review instead of allowing it.
KORTEX_SAFETY_FAIL_CLOSED=false
# Tenants younger than this many hours have links to never-seen domains held for review.
KORTEX_SAFETY_HOLD_HOURS=24
# Storage object the feed sync writes and the runtime reads (default shown).
KORTEX_SAFETY_FEED_PATH=kortex-safety/blocked-hosts.txt
